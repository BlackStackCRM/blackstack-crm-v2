# BlackStack CRM V2 — Server Launcher Configuration Example
#
# Copy this file to launcher/.env and adjust as needed.
#
# The launcher is the always-running gateway on port 3000 (the port the user
# opens in the browser). When the CRM backend is stopped, it serves a
# "Server Offline / Start CRM Server" page instead of a connection error.
# When the CRM is running, it reverse-proxies all requests to it.

# Port the launcher listens on (user-facing — what the browser opens)
LAUNCHER_PORT=3000

# Port the CRM backend runs on internally (launcher proxies 3000 -> this)
LAUNCHER_CRM_PORT=3001

# --- CRM startup configuration (forwarded to server/app.js) ---
NODE_ENV=development
DEMO_MODE=true
DB_PATH=./data/blackstack-crm.db
