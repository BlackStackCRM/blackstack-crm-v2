# ❗ NEVER commit .env. Copy to .env in the deployment environment.
PORT=8443
DB_PATH=./license.db
# Token audience declares this server's identity; clients must match exactly.
TOKEN_AUDIENCE=license-server
# HS256 signing key for service-token JWT (>= 256-bit random = 64 hex chars).
# Generate with: openssl rand -hex 32
JWT_SECRET=""  # set at deployment — do not commit
JWT_EXPIRY=15m
CLOCK_TOLERANCE_MS=60000
NODE_ENV=development
